FLASK_PORT=5000
FLASK_ENV=development
# auto: OpenAI 키가 있으면 OpenAI Vision, 없으면 BioCLIP(설치 시), 그것도 없으면 색상 카탈로그
# openai | bioclip | local
AI_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_GUIDE_MODEL=gpt-4o-mini

# 로컬 식별 모델 (BioCLIP, GPU가 있으면 자동으로 CUDA 사용)
BIOCLIP_MODEL=hf-hub:imageomics/bioclip-2

# 로컬 LLM 가이드 (Ollama). OpenAI 키가 없을 때 사용되며, 비워 두면 카탈로그 가이드를 씁니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GUIDE_MODEL=gemma4:12b
